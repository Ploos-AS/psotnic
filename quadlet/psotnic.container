[Unit]
Description=Psotnic IRC channel-protection bot
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/ploos-as/psotnic:0.1.1
ContainerName=psotnic
User=1000:1000
Environment=PSOTNIC_CONFIG=/data/psotnic.conf
Volume=%h/.local/share/psotnic:/data:Z
DropCapability=all
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=default.target
